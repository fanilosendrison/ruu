{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruu.dev/schemas/qualification-lineage-v2.schema.json",
  "title": "Ruu qualification lineage version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_for",
    "generated_on",
    "source_snapshot",
    "retention_policy",
    "source_packages",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "lineage-v2.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "generated_for": {
      "type": "string",
      "minLength": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lineage_path",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lineage_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_is_immutable",
        "active_artifact_bytes_must_match_snapshot",
        "active_discovery_excludes",
        "retained_discovery_excludes",
        "missing_historical_baseline_is_never_a_pass"
      ],
      "properties": {
        "snapshot_is_immutable": {
          "const": true
        },
        "active_artifact_bytes_must_match_snapshot": {
          "const": true
        },
        "active_discovery_excludes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retained_discovery_excludes": {
          "const": [
            "qualification/state-space/post-baseline"
          ]
        },
        "missing_historical_baseline_is_never_a_pass": {
          "const": true
        }
      }
    },
    "source_packages": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "status",
        "source",
        "original_path",
        "current_path",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "state-space-report",
            "state-space-executable",
            "state-space-recorded-output",
            "git-smoke-script",
            "git-smoke-recorded-output"
          ]
        },
        "status": {
          "const": "RETAINED"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "original_path": {
          "type": "string",
          "minLength": 1
        },
        "current_path": {
          "type": "string",
          "pattern": "^qualification/(state-space/v[0-9]{3}/state-space-audit-v[0-9]+[.](md|py|txt)|git-smoke/[a-z0-9-]+/git-[a-z0-9-]+-smoke-v[0-9]+[.](sh|txt))$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
